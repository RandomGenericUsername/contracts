{
  "schemaVersion": 2,
  "name": "paper",
  "groups": {
    "surface": {
      "panel": {
        "bg": "transparent",
        "border": "alpha(@outline, 0.5)",
        "border-width": 1,
        "radius": 6,
        "padding": 8,
        "shadow": "0 2px 8px alpha(@shadow, 0.18)",
        "blur": "none"
      },
      "card": {
        "bg": "color-mix(in srgb, @surface 92%, transparent)",
        "border": "alpha(@outline, 0.4)",
        "border-width": 1,
        "radius": 4,
        "padding": 5
      },
      "cell": {
        "bg": "transparent",
        "border": "transparent",
        "border-width": 0,
        "radius": 3,
        "padding": 5,
        "hover-bg": "color-mix(in srgb, @on_surface 8%, transparent)"
      },
      "control": {
        "bg": "transparent",
        "border": "alpha(@outline, 0.5)",
        "border-width": 1,
        "radius": 3,
        "padding": 3,
        "font-size": 12,
        "font-weight": 500
      },
      "pill": {
        "bg": "alpha(@tertiary, 0.12)",
        "border": "alpha(@tertiary, 0.4)",
        "border-width": 1,
        "radius": 20,
        "padding": 2,
        "font-size": 9,
        "letter-spacing": 0.06
      },
      "window": {
        "bg": "@surface_container_lowest",
        "border": "alpha(@on_surface, 0.22)",
        "border-width": 1,
        "radius": 6,
        "padding": 11,
        "shadow": "0 2px 8px alpha(@shadow, 0.18)",
        "blur": "none",
        "opacity": 1.0
      }
    },
    "state": {
      "hover": {
        "fill": "color-mix(in srgb, @on_surface 8%, transparent)",
        "ink": "@on_surface",
        "ring": "@tertiary"
      },
      "selected": {
        "fill": "@tertiary_container",
        "ink": "@on_tertiary_container",
        "ring": "@tertiary"
      },
      "focus": {
        "fill": "transparent",
        "ink": "@on_surface",
        "ring": "@tertiary"
      },
      "disabled": {
        "fill": "transparent",
        "ink": "alpha(@on_surface, 0.4)",
        "ring": "transparent"
      }
    },
    "type": {
      "font-family": "serif",
      "font-weight": 400,
      "letter-spacing": 0.02,
      "size-caption": 10,
      "size-meta": 11,
      "size-body": 13,
      "size-title": 16,
      "size-display": 20
    },
    "ink": {
      "ink": "@on_surface",
      "ink-dim": "color-mix(in srgb, @on_surface_variant 70%, transparent)",
      "accent": "@tertiary",
      "accent-muted": "alpha(@tertiary, 0.35)",
      "ink-over": "auto"
    },
    "layout": {
      "bar": {
        "panel-width": 420,
        "bt-list-spacing": 10,
        "bar-row-height": 34,
        "chip-min": 80
      }
    }
  },
  "mode": {
    "light": {
      "surface": {
        "panel": {
          "bg": "color-mix(in srgb, @surface_container_lowest 96%, transparent)",
          "border": "alpha(@outline, 0.35)",
          "border-width": 1,
          "radius": 6,
          "padding": 8,
          "shadow": "0 2px 8px alpha(@shadow, 0.12)",
          "blur": "none"
        },
        "card": {
          "bg": "color-mix(in srgb, @surface 96%, transparent)",
          "border": "alpha(@outline, 0.3)",
          "border-width": 1,
          "radius": 4,
          "padding": 5
        },
        "cell": {
          "bg": "transparent",
          "border": "transparent",
          "border-width": 0,
          "radius": 3,
          "padding": 5,
          "hover-bg": "color-mix(in srgb, @on_surface 6%, transparent)"
        },
        "control": {
          "bg": "@surface_container_low",
          "border": "alpha(@outline, 0.4)",
          "border-width": 1,
          "radius": 3,
          "padding": 3,
          "font-size": 12,
          "font-weight": 500
        },
        "pill": {
          "bg": "alpha(@tertiary, 0.1)",
          "border": "alpha(@tertiary, 0.35)",
          "border-width": 1,
          "radius": 20,
          "padding": 2,
          "font-size": 9,
          "letter-spacing": 0.06
        },
        "window": {
          "bg": "color-mix(in srgb, @surface_container_lowest 96%, transparent)",
          "border": "alpha(@outline, 0.35)",
          "border-width": 1,
          "radius": 6,
          "padding": 11,
          "shadow": "0 2px 8px alpha(@shadow, 0.12)",
          "blur": "none",
          "opacity": 1.0
        }
      },
      "state": {
        "hover": {
          "fill": "color-mix(in srgb, @on_surface 6%, transparent)",
          "ink": "@on_surface",
          "ring": "@tertiary"
        },
        "selected": {
          "fill": "@tertiary_container",
          "ink": "@on_tertiary_container",
          "ring": "@tertiary"
        },
        "focus": {
          "fill": "transparent",
          "ink": "@on_surface",
          "ring": "@tertiary"
        },
        "disabled": {
          "fill": "transparent",
          "ink": "alpha(@on_surface, 0.4)",
          "ring": "transparent"
        }
      },
      "ink": {
        "ink": "@on_surface",
        "ink-dim": "alpha(@on_surface_variant, 0.8)",
        "accent": "@tertiary",
        "accent-muted": "alpha(@tertiary, 0.35)",
        "ink-over": "auto"
      }
    }
  }
}
